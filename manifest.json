{
  "manifest_version": 3,
  "name": "Reverse YouTube Playlist",
  "version": "1.0.6",
  "description": "Play YouTube playlists in reverse order (bottom to top). Adds a Reverse toggle button to the playlist panel.",
  "browser_specific_settings": {
    "gecko": {
      "id": "reverse-playlist@benmoussa",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["src/content.js"],
      "css": ["src/button.css"],
      "run_at": "document_idle"
    }
  ]
}
