{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "3.6.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "reverse-playlist@benmoussa",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup/popup.html"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "background": {
    "scripts": [
      "src/background.js"
    ]
  },
  "commands": {
    "toggle-reverse": {
      "suggested_key": {
        "default": "Alt+Shift+O"
      },
      "description": "__MSG_cmdReverse__"
    },
    "toggle-shuffle": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "__MSG_cmdShuffle__"
    },
    "add-to-list": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "__MSG_cmdAddToList__"
    },
    "load-all": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "__MSG_cmdLoadAll__"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "src/backup.js",
        "src/links.js",
        "src/state.js",
        "src/playlist.js",
        "src/stats.js",
        "src/playback.js",
        "src/sidebar.js",
        "src/panel.js",
        "src/toolbar.js",
        "src/content.js"
      ],
      "css": [
        "src/button.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
