# API Credentials — copy this file to .env and fill in your values.
# ⚠️ NEVER commit .env to git. It is already in .gitignore.

# =============================================================================
# Firefox (AMO) Auto-Publish Credentials
# Get key and secret from: https://addons.mozilla.org/developers/addon/api/key/
# =============================================================================
AMO_JWT_ISSUER=user:XXXXX:XX
AMO_JWT_SECRET=your-long-api-secret-here
AMO_ADDON_ID=reverse-playlist@benmoussa

# =============================================================================
# Chrome Web Store API Auto-Publish Credentials
# Get Client ID, Secret & Refresh Token from Google Cloud Console:
# https://console.cloud.google.com
# =============================================================================
CHROME_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
CHROME_CLIENT_SECRET=your-google-client-secret
CHROME_REFRESH_TOKEN=your-google-oauth-refresh-token
CHROME_ITEM_ID=your-chrome-extension-item-id
