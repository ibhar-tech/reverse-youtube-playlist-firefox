# AMO API credentials — copy this file to .env and fill in your values.
# Get your key and secret from:
# https://addons.mozilla.org/developers/addon/api/key/
#
# ⚠️  NEVER commit .env to git. It is already in .gitignore.

# Your API Key (looks like: user:12345:67)
AMO_JWT_ISSUER=user:XXXXX:XX

# Your API Secret (long random string)
AMO_JWT_SECRET=your-long-api-secret-here

# Your extension's ID — use the gecko.id from manifest.json
# (the part before @, or the full email-style ID)
AMO_ADDON_ID=reverse-playlist@benmoussa
